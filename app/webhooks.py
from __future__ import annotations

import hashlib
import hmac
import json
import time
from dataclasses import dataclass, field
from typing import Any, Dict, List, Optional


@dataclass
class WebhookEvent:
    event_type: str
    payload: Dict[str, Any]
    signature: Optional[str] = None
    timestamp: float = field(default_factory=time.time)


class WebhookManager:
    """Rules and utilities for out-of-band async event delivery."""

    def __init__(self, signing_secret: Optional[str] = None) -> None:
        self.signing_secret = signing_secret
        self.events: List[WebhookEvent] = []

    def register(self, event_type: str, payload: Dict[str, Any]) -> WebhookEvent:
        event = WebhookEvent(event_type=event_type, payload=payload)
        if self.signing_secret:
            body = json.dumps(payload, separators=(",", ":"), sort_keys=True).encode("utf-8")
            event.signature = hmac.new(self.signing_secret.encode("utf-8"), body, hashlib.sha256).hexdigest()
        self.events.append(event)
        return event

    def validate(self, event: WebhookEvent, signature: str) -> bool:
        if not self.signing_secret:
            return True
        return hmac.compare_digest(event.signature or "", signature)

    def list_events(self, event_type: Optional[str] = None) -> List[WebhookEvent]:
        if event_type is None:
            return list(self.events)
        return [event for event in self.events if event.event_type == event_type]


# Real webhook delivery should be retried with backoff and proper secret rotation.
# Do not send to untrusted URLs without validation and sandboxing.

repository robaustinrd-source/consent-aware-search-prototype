from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional


@dataclass
class ConnectorStatus:
    connector_id: str
    name: str
    status: str
    network: bool = False
    requires_consent: bool = True
    requires_api_key: bool = False
    notes: str = ""


@dataclass
class ProviderConfig:
    connector_id: str
    name: str
    enabled: bool = False
    priority: int = 100
    api_key: Optional[str] = None
    base_url: Optional[str] = None
    timeout_seconds: int = 15
    allow_private_results: bool = False
    consent_required: bool = True
    extra: Dict[str, Any] = field(default_factory=dict)


class ConnectorAdapter:
    """Base adapter interface for approved external search providers."""

    def __init__(self, config: ProviderConfig) -> None:
        self.config = config

    def status(self) -> ConnectorStatus:
        return ConnectorStatus(
            connector_id=self.config.connector_id,
            name=self.config.name,
            status="not_configured" if not self.config.enabled else "ready",
            network=True,
            requires_consent=self.config.consent_required,
            requires_api_key=self.config.api_key is None,
            notes="Use only through provider-approved APIs or user-authorized integrations.",
        )

    async def search(self, query: str, **kwargs: Any) -> List[Dict[str, Any]]:
        raise NotImplementedError("Provider adapter must implement search().")


class ConnectorRegistry:
    """Concrete registry of approved connectors. This is a scaffold only."""

    def __init__(self) -> None:
        self.connectors: Dict[str, ConnectorAdapter] = {}

    def register(self, adapter: ConnectorAdapter) -> None:
        self.connectors[adapter.config.connector_id] = adapter

    def status(self) -> List[ConnectorStatus]:
        return [self.connectors[identifier].status() for identifier in sorted(self.connectors)]

    def by_id(self, connector_id: str) -> Optional[ConnectorAdapter]:
        return self.connectors.get(connector_id)


