from __future__ import annotations

import logging
from pathlib import Path
from typing import Dict, Iterable, List, Optional


class DocumentNormalizer:
    """Generic document normalizer for text extraction, OCR, and metadata cleanup."""

    def __init__(self, ocr_backend: Optional[str] = None) -> None:
        self.ocr_backend = ocr_backend

    def normalize(self, text: str) -> str:
        return " ".join(text.split())


class OCRPipeline:
    """Shim for OCR / format conversion. Real implementation requires installed OCR tooling."""

    def __init__(self, supported_extensions: Optional[Iterable[str]] = None) -> None:
        self.supported_extensions = set(supported_extensions or {".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff"})
        self.logger = logging.getLogger("ocr_pipeline")

    def supported(self, path: str | Path) -> bool:
        return Path(path).suffix.lower() in self.supported_extensions

    def extract(self, path: str | Path) -> str:
        target = Path(path)
        if not self.supported(target):
            raise ValueError(f"Unsupported OCR extension: {target.suffix}")
        self.logger.warning("OCR pipeline is a scaffold only; install an OCR backend before use.")
        return target.read_text(encoding="utf-8", errors="replace") if target.suffix.lower() in {".txt"} else ""


